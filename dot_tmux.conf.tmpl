set -g base-index 1                         # Start window numbering at 1
set -g renumber-windows on                  # Renumber windows when one is closed
set -g mouse on                             # Enable mouse support
set -g default-terminal "tmux-256color"     # Enable true colour support (optional)
# set -ga terminal-overrides ",*256col*:Tc"
set -as terminal-features ",*:RGB"

# Change prefix from Ctrl-b → Alt-z
unbind C-b
set-option -g prefix M-z
bind-key M-z send-prefix
bind l send-keys C-l                        # use leader + l to clear terminal (ctrl+l used by vim-tmux-nav)

# bind h select-pane -L
# bind j select-pane -D
# bind k select-pane -U
# bind l select-pane -R
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# New pane inherits current pane's path
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
unbind '"'
unbind %

# copy keys
set-window-option -g mode-keys vi

bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi y send-keys -X copy-selection-and-cancel

# System clipboard integration (optional)
# bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "xclip -selection clipboard"


### Plugins

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'omerxx/tmux-sessionx'

# Reload config
bind r source-file ~/.tmux.conf \; display "Config reloaded!"

# Machine-specific overrides
{{- if ne .chezmoi.username "alan" }}
source ~/.config/tmux/.tmux-theme-tokyonight.conf
{{- else }}
source ~/.config/tmux/.tmux-theme-catppuccin.conf
# Toggle local keybindings on/off with F12
bind -T root F12  \
  set prefix None \;\
  set key-table off \;\
  if -F '#{pane_in_mode}' 'send-keys -X cancel' \;\
  refresh-client -S

bind -T off F12 \
  set -u prefix \;\
  set -u key-table \;\
  refresh-client -S
{{- end }}

run '~/.tmux/plugins/tpm/tpm'

